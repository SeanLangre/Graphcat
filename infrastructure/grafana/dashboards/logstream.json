{
  "uid": "logstream",
  "title": "LogStream",
  "tags": [
    "logstream"
  ],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "afz08sm46ot8gd"
        },
        "query": {
          "label": "device_id",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"logstream\"}",
          "type": 1
        },
        "definition": "label_values({job=\"logstream\"}, device_id)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "afz08sm46ot8gd"
        },
        "query": {
          "label": "level",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"logstream\"}",
          "type": 1
        },
        "definition": "label_values({job=\"logstream\"}, level)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "afz08sm46ot8gd"
        },
        "query": {
          "label": "app",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"logstream\"}",
          "type": 1
        },
        "definition": "label_values({job=\"logstream\"}, app)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "tag",
        "label": "Tag",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "afz08sm46ot8gd"
        },
        "query": {
          "label": "tag",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"logstream\"}",
          "type": 1
        },
        "definition": "label_values({job=\"logstream\"}, tag)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Case-insensitive regex matched against the log line"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "datasource": {
        "type": "loki",
        "uid": "afz08sm46ot8gd"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "afz08sm46ot8gd"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum by (level) (count_over_time({job=\"logstream\", device_id=~\"$device\", level=~\"$level\", tag=~\"$tag\", app=~\"$app\"} |~ \"(?i)$search\" [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "debug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors by app (top 10)",
      "datasource": {
        "type": "loki",
        "uid": "afz08sm46ot8gd"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "afz08sm46ot8gd"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "topk(10, sum by (app) (count_over_time({job=\"logstream\", device_id=~\"$device\", level=~\"error|critical\", tag=~\"$tag\", app=~\"$app\"} |~ \"(?i)$search\" [$__auto])))",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Android Logs",
      "datasource": {
        "type": "loki",
        "uid": "afz08sm46ot8gd"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "afz08sm46ot8gd"
          },
          "editorMode": "code",
          "queryType": "range",
          "direction": "backward",
          "expr": "{job=\"logstream\", device_id=~\"$device\", level=~\"$level\", tag=~\"$tag\", app=~\"$app\"} |~ \"(?i)$search\""
